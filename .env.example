# Auth.js — generate with: npx auth secret
AUTH_SECRET=

# Spotify app (https://developer.spotify.com/dashboard)
# Redirect URI to register: http://127.0.0.1:3000/api/auth/callback/spotify
AUTH_SPOTIFY_ID=
AUTH_SPOTIFY_SECRET=

# Only needed when not on 127.0.0.1:3000 (e.g. ngrok tunnel for phone testing)
# AUTH_URL=https://your-tunnel.ngrok-free.app

# Local Postgres from docker-compose.yml (docker compose up -d).
# Hosted later: Supabase → Connect → Transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/layla

# LLM analysis
ANTHROPIC_API_KEY=

# Protects /api/cron/sync. Generate with: openssl rand -hex 32
CRON_SECRET=
